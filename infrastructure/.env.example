# Copy to infrastructure/.env on the NAS (next to docker-compose.yml). Nothing confidential belongs here.

# LAN address of the NAS (reserve it in the router, see the runbook). Never use 0.0.0.0.
DASHBOARD_BIND_IP=192.168.1.20
DASHBOARD_PORT=8080

# Numeric user and group that own the config, data and backup folders on the NAS.
DASHBOARD_UID=1000
DASHBOARD_GID=100
