# Copy to scripts/deploy.env (git-ignored). No passwords or application secrets belong here.

# NAS address as reachable from the Mac and the user created for deployments (see the runbook).
NAS_HOST=dashboard.home
NAS_USER=dashboard-deploy

# Dedicated, passphrase-protected ed25519 key used only for this user (ssh-keygen -t ed25519).
NAS_SSH_KEY=~/.ssh/home-dashboard-deploy

# Optional: a separate known_hosts file that holds only the NAS host key.
# NAS_KNOWN_HOSTS=~/.ssh/known_hosts_home_dashboard

# Project folder on the NAS (contains docker-compose.yml, .env, config, data, backup).
NAS_DIR=/volume1/docker/home-dashboard

# Docker binary on the NAS and the number of image versions to keep.
NAS_DOCKER=/usr/local/bin/docker
KEEP_TAGS=3
